# Maintainer: Gary Robson
pkgname=kglanceqt
pkgver=0.3.0rc1
_tag=qt-v0.3.0-rc.1
pkgrel=1
pkgdesc='Native Qt 6 and KDE Frameworks 6 file previews for Dolphin and Plasma'
arch=('x86_64')
url='https://github.com/garyrobson/KglanceQT'
license=('AGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'qt6-base>=6.6' 'qt6-multimedia' 'sqlite>=3.41'
         'kparts' 'ktexteditor' 'kio' 'karchive' 'kwindowsystem' 'baloo-widgets' 'kwidgetsaddons' 'kfilemetadata>=6.2' 'kxmlgui' 'kconfigwidgets' 'kiconthemes>=6.3' 'kcolorscheme')
makedepends=('cmake' 'ninja' 'python')
checkdepends=('dbus' 'glib2' 'qt6-tools' 'okular')
optdepends=('okular: PDF and supported document previews'
            'qt6-svg: SVG previews'
            'qt6-imageformats: additional image formats'
            'kimageformats: KDE image format plugins'
            'kio-extras: additional KIO protocols and thumbnail providers'
            'kdegraphics-thumbnailers: document thumbnails'
            'plasma-workspace: desktop:/ URLs and font viewer component')
conflicts=('kglance' 'kglance-git')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('a8a76feb7a6bb9e8851e38c7a9159ae299ed8749b1c494e4f3a02c6fbf958528')

build() {
    cmake -S "$srcdir/KglanceQT-$_tag" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=ON \
        -DKGLANCEQT_WITH_SQLITE=ON
    cmake --build "$srcdir/build" --parallel 2
}

check() {
    dbus-run-session -- ctest --test-dir "$srcdir/build" --output-on-failure --parallel 2
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
